# ==========================================================
# Zerodha Kite Connect API Configuration
# Get these credentials from: https://kite.trade/
# ==========================================================

KITE_API_KEY="your_api_key_here"
KITE_API_SECRET="your_api_secret_here"

# (Optional) User ID / Client ID on Zerodha (e.g., AB1234)
KITE_USER_ID="your_zerodha_user_id"

# (Optional) TOTP Secret Key if you automate TOTP generation with pyotp
KITE_TOTP_KEY="your_totp_secret_key"

# Access Token (Generated daily via auth.py)
KITE_ACCESS_TOKEN=""

# Strategy Settings
MAX_CAPITAL_PER_TRADE=10000
MAX_DAILY_LOSS=2000
SEMI_AUTOMATED_CONFIRMATION=true
