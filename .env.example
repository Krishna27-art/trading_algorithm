# Strategy Settings
MAX_CAPITAL_PER_TRADE=10000
MAX_DAILY_LOSS_LIMIT=2000
SEMI_AUTOMATED_CONFIRMATION=true

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This MUST be set to a non-empty value for the backend to start.
APP_SHARED_SECRET='CHANGE_ME_GENERATE_A_REAL_SECRET'
